{
  "name": "agents-gui",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.4",
  "publisher": "agents-gui",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/trry-hub/agents-gui.git"
  },
  "bugs": {
    "url": "https://github.com/trry-hub/agents-gui/issues"
  },
  "homepage": "https://github.com/trry-hub/agents-gui",
  "keywords": [
    "ai",
    "assistant",
    "claude",
    "codex",
    "gemini",
    "opencode",
    "goose",
    "aider",
    "multi-agent",
    "workbench"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onView:agents-gui.sidebar",
    "onCommand:agents-gui.openPanel",
    "onCommand:agents-gui.reloadWindow",
    "onCommand:agents-gui.refreshProviders",
    "onCommand:agents-gui.openProviderSettings",
    "onCommand:agents-gui.stopAll",
    "onCommand:agents-gui.explainSelection",
    "onCommand:agents-gui.reviewFile",
    "onCommand:agents-gui.generateTests",
    "onCommand:agents-gui.refactorSelection",
    "onCommand:agents-gui.generateCommitMessage",
    "onCommand:agents-gui.cancelCommitMessageGeneration",
    "onCommand:agents-gui.setupCommitMessage"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agents-gui",
          "title": "%viewContainer.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agents-gui": [
        {
          "id": "agents-gui.sidebar",
          "name": "%view.sidebar.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agents-gui.openPanel",
        "title": "%command.openPanel.title%"
      },
      {
        "command": "agents-gui.reloadWindow",
        "title": "%command.reloadWindow.title%"
      },
      {
        "command": "agents-gui.refreshProviders",
        "title": "%command.refreshProviders.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "agents-gui.openProviderSettings",
        "title": "%command.openProviderSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agents-gui.stopAll",
        "title": "%command.stopAll.title%"
      },
      {
        "command": "agents-gui.explainSelection",
        "title": "%command.explainSelection.title%"
      },
      {
        "command": "agents-gui.reviewFile",
        "title": "%command.reviewFile.title%"
      },
      {
        "command": "agents-gui.generateTests",
        "title": "%command.generateTests.title%"
      },
      {
        "command": "agents-gui.refactorSelection",
        "title": "%command.refactorSelection.title%"
      },
      {
        "command": "agents-gui.generateCommitMessage",
        "title": "%command.generateCommitMessage.title%",
        "icon": {
          "light": "media/commit-message-light.svg",
          "dark": "media/commit-message-dark.svg"
        }
      },
      {
        "command": "agents-gui.cancelCommitMessageGeneration",
        "title": "%command.cancelCommitMessageGeneration.title%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agents-gui.setupCommitMessage",
        "title": "%command.setupCommitMessage.title%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agents-gui.refreshProviders",
          "when": "view == agents-gui.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "agents-gui.openProviderSettings",
          "when": "view == agents-gui.sidebar",
          "group": "navigation@2"
        }
      ],
      "scm/title": [
        {
          "command": "agents-gui.cancelCommitMessageGeneration",
          "when": "scmProvider == git && scmProviderRootUri in agents-gui.commitMessageGeneratingRoots",
          "group": "navigation@-100"
        },
        {
          "command": "agents-gui.generateCommitMessage",
          "when": "scmProvider == git && agents-gui.hasStagedChanges && !agents-gui.commitMessageGenerating",
          "group": "navigation@-100"
        }
      ],
      "editor/context": [
        {
          "command": "agents-gui.explainSelection",
          "when": "editorHasSelection",
          "group": "navigation@10"
        },
        {
          "command": "agents-gui.refactorSelection",
          "when": "editorHasSelection",
          "group": "navigation@11"
        },
        {
          "command": "agents-gui.reviewFile",
          "group": "navigation@12"
        },
        {
          "command": "agents-gui.generateTests",
          "group": "navigation@13"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "agents-gui.defaultProvider": {
          "type": "string",
          "default": "opencode",
          "enum": [
            "claude",
            "gemini",
            "codex",
            "opencode",
            "goose",
            "aider"
          ],
          "description": "%config.defaultProvider.description%"
        },
        "agents-gui.context.includeWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeWorkspace.description%"
        },
        "agents-gui.context.includeCurrentFile": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeCurrentFile.description%"
        },
        "agents-gui.context.includeSelection": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeSelection.description%"
        },
        "agents-gui.context.includeDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeDiagnostics.description%"
        },
        "agents-gui.context.maxFileChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "description": "%config.maxFileChars.description%"
        },
        "agents-gui.context.maxSelectionChars": {
          "type": "number",
          "default": 8000,
          "minimum": 1000,
          "description": "%config.maxSelectionChars.description%"
        },
        "agents-gui.context.maxDiagnostics": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "description": "%config.maxDiagnostics.description%"
        },
        "agents-gui.home.visibleAgentIds": {
          "type": "array",
          "default": [],
          "description": "%config.home.visibleAgentIds.description%",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "gemini",
              "codex",
              "opencode",
              "goose",
              "aider"
            ]
          }
        },
        "agents-gui.home.agentOrder": {
          "type": "array",
          "default": [],
          "description": "%config.home.agentOrder.description%",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "gemini",
              "codex",
              "opencode",
              "goose",
              "aider"
            ]
          }
        },
        "agents-gui.apiProviders.customProviders": {
          "type": "array",
          "default": [],
          "description": "%config.apiProviders.customProviders.description%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "apiKey": {
                "type": "string",
                "description": "%config.apiProviders.customProviders.apiKey.description%"
              },
              "apiKeyEnv": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "extraEnv": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "enabled": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "agents-gui.apiProviders.defaultProviderId": {
          "type": "string",
          "default": "",
          "description": "%config.apiProviders.defaultProviderId.description%"
        },
        "agents-gui.apiProviders.agentProviderByCliId": {
          "type": "object",
          "default": {},
          "description": "%config.apiProviders.agentProviderByCliId.description%",
          "additionalProperties": {
            "type": "string"
          }
        },
        "agents-gui.commitMessage.provider": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "claude",
            "gemini",
            "codex",
            "opencode",
            "goose",
            "aider"
          ],
          "description": "%config.commitMessage.provider.description%"
        },
        "agents-gui.commitMessage.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "description": "%config.commitMessage.language.description%"
        },
        "agents-gui.commitMessage.maxDiffChars": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "%config.commitMessage.maxDiffChars.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:test": "tsc -p tsconfig.json --outDir .test-dist --rootDir src --module commonjs",
    "test": "npm run build:test && node --test tests/*.test.mjs",
    "watch": "node esbuild.mjs --watch",
    "compile": "npm run build",
    "package": "npm run build && npx --yes @vscode/vsce package",
    "changelog": "node scripts/generate-changelog.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "js-tiktoken": "^1.0.21"
  }
}
